# =============================================================================
# TallyPrime -> SQL Server Migration Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# TALLY CONFIGURATION
# ---------------------------------------------------------------------------
# Full Tally URL (Alternative to TALLY_HOST + TALLY_PORT)
# TALLY_URL=http://hostname:9938

# Hostname or IP of the TallyPrime server
# On the production Windows machine this will be the actual Tally host
TALLY_HOST=localhost

# Port where TallyPrime is listening (default: 9000)
TALLY_PORT=9000

# Integration protocol: 'xml' (HTTP/TDL) or 'odbc'
# 'xml' is preferred for most use cases
# 'odbc' requires Tally ODBC driver installed on the machine running this app
TALLY_PROTOCOL=xml

# Tally company name (leave empty to use the currently active company)
TALLY_COMPANY=

# Tally connection timeout in seconds
TALLY_TIMEOUT=30

# ODBC settings (only needed if TALLY_PROTOCOL=odbc)
# TALLY_ODBC_DSN=
# TALLY_ODBC_DRIVER=Tally ODBC Driver

# ---------------------------------------------------------------------------
# SQL SERVER CONFIGURATION
# ---------------------------------------------------------------------------
# SQL Server hostname or IP
SQL_SERVER=localhost

# SQL Server port (default: 1433)
SQL_PORT=1433

# Database name
SQL_DATABASE=TallyDB

# SQL Server credentials
# SQL_USER (or SQL_USERNAME) and SQL_PASSWORD
# Leave empty to use Windows Authentication
SQL_USER=
SQL_USERNAME=
SQL_PASSWORD=

# Use Windows Authentication (overrides username/password)
# Set to 'true' to use Trusted_Connection
SQL_TRUSTED_CONNECTION=false

# ODBC Driver for SQL Server
# Adjust version number to match your installed driver
SQL_DRIVER=ODBC Driver 17 for SQL Server

# SQL schema name (default: dbo)
SQL_SCHEMA=dbo

# SSL settings
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERT=false

# ---------------------------------------------------------------------------
# MIGRATION CONFIGURATION
# ---------------------------------------------------------------------------
# Number of records processed per batch (memory control)
# Larger = faster, more memory. Smaller = slower, less memory.
BATCH_SIZE=5000

# Maximum retries for transient failures
MAX_RETRIES=3

# Seconds to wait between retries (exponential backoff base)
RETRY_BACKOFF_SECONDS=2.0

# Dry run mode: validate without writing to SQL (true/false)
DRY_RUN=false

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for log files (created if not exists)
LOG_DIR=logs

# ---------------------------------------------------------------------------
# SCHEMA PATHS
# ---------------------------------------------------------------------------
# Directory for schema files (discovered_schema.json)
SCHEMA_DIR=schema

# Directory for SQL DDL files
SQL_DIR=sql

# ---------------------------------------------------------------------------
# OPTIONAL: Limit collections to process (comma-separated)
# Leave empty to process all collections
# COLLECTIONS=Ledger,Voucher,StockItem
# ---------------------------------------------------------------------------
COLLECTIONS=
